; >S:VARIETY; PUT "VARIETY";;GETDEF;; SETS UP CHARS FOR ALIEN ON; THIS SHEET.;; BOTH CHARS ARE LEFT IN THE; SCREEN BUFFER;; CHAR#1 ALIBUF; CHAR#2 ALIBUF+32; CHAR#3 ALIBUF+64; CHAR#4 ALIBUF+96;; RANDOM NUMBERS CONTINUALLY; GENERATED FORM RASTER;LDA DUCK   ;* SAME ALIENS AS B4?BEQ OUTDUK ;* NO;LDA ALIENS ;* LAST TYPEJMP QUAZI;OUTDUK;LDA TEDAND #3PHA;JSR RANDOM;PLATAX;LDA RND,X;AND #15    ;* SIXTEEN TYPESSTA ALIENS ;* ALIEN NUMBER;QUAZI;JSR RANDOM;LDA RND+1AND #7BEQ QUAZI  ;* NO BLACKS !;CMP #6BEQ QUAZI  ;* NO BLUES !;ORA #8STA ALICOL ;* RANDOM COLOUR;LDA ALIENSPHAAND #1CLCROR AROR ASTA WORK;; ACC = 0 OR $80;PLALSR ASTA WORK+1;; WORK,WORK+1 = ALIEN# * 128;LDA WORKCLCADC #<ALIBASSTA WORK;LDA WORK+1ADC #>ALIBASSTA WORK+1;LDY #127;DEFER;LDA (WORK),Y  ;* CHAR DATASTA ALIBUF,Y;DEYBPL DEFER;LDA #1STA DEFTEM   ;* TEMPO;RTS;;;;;;.END