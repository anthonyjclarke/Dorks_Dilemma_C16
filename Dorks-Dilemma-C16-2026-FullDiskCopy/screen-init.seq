; >S:SCREEN-INIT; PUT "SCREEN-INIT";; SET UP THE WINDOW FOR PLAY;SETWIN;LDX #<WELCHLDY #>WELCH;JSR PWINT;LDA #$79STA $D965STA $D966STA $D965+40STA $D966+40;; COLOUR FOR BOMB;RTS;;-----------------;; PRINT COLOUR ON HISCORE TABLE; FOR THE J/K AND Q/S CHARS; AND BORDER COLORS;SLUDGE;LDX #31;QUEEN1;LDA #37STA $400,XSTA $798,X;DEXBPL QUEEN1;LDA #23STA TY;QUEEN2;LDX #0LDY TYJSR XY;LDY #0LDA #37STA (SL),Y;LDA #0STA (CL),Y;LDA #37LDY #31STA (SL),Y;LDA #0STA (CL),Y;DEC TYBNE QUEEN2;LDX #31LDY #0;QUEEN3;LDA TCOL,Y;STA $D800,YSTA $DBB7-31,X;INYDEXBPL QUEEN3;;RTS;TCOL;.BYTE 7,6,5,4,3,2,1,7,6,5,4,3,2,1.BYTE 7,6,5,4,3,2,1,7,6,5,4,3,2,1.BYTE 7,6,5,4;;;********************************;WELCH;.BYTE 33,1,$03,100,68,92,98,72,213,0.BYTE 33,2,$05,101,69,93,99,73,214,0;; 'SCORE';.BYTE 33,3,$01,32,32,32,32,32,$30,0;; '    0';.BYTE 33,4,$07,$C,9,$16,5,$13,$3A,0;; 'LIVES:';.BYTE 35,5,$01,$33,0;; '  3';.BYTE 33,6,$07,1,$C,9,5,$E,$13,0;; 'ALIENS';.BYTE 35,7,$01,32,32,0;; ' 20';.BYTE 33,8,$03,66,92,88,66,44,45,0.BYTE 33,9,$05,67,93,89,67,46,47,0;; 'BOMB';.BYTE 33,11,$05,10,9,7,19,1,$17,0;; 'JIGSAW';.BYTE 33,19,$77,$D,0.BYTE 33,20,$77,$1,0.BYTE 33,21,$77,$10,0;; 'MAP';.BYTE $FF;;;.END