; >S:JOYSTIK; PUT "JOYSTIK";;*******************;; READ THE JOYSTICK;;*******************;;READJS;; FIRST TRY PORT 2;LDA JOYSELBNE WAKEUP;JMP REAKEY;WAKEUP;LDA #$00STA $DC02;LDA PRTA   ;* PORT AEOR #$FFAND #$1FBNE NAYE;; THEN TRY PORT 1;LDA #$00STA $DC03;LDA PRTB   ;* PORT BEOR #$FFAND #$1FBNE NAYE;; NO MOVE-MENT;NOMOVE;LDA #0LDX #5;NOM1;STA JLEFT,XDEXBPL NOM1;RTS;NAYE;ROR AROR JUP;ROR AROR JDOWN;ROR AROR JLEFT;ROR AROR JRIGHT;ROR A;ROR JFIRE;LDA #1STA JMOVE;RTS;;-------------------------;REAKEY;LDA #4STA IRQWRK;LDX #$FFSTX $DC02;INXSTX $DC03STX JMOVE;READK1;LDX IRQWRK;LDA BITDAT,XLDY LATDAT,X;JSR KEYIT;PHP;ROR JLEFT,X;PLPROR JMOVE;DEC IRQWRKBPL READK1;LDA JMOVEBNE HITMET;JMP NOMOVE;HITMET;RTS;;--------------------------------;KEYIT;STY $DC00;NOPNOP;BIT $DC01;BNE CLRED;SEC;RTS;CLRED;CLC;RTS;;------------;DEFVAL .BYTE 'ZX;/',$8E;LATDAT .BYTE $FD,$FB,$BF,$BF,$7F;BITDAT .BYTE $10,$80,$04,$80,$10;;; DEFAULTS = Z,X,;,/,SPACE;.END