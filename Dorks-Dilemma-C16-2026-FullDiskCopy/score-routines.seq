; >S:SCORE-ROUTINES; PUT "SCORE-ROUTINES";;SCOREP=$421+120;; CALLED WITH ACC HOLDING VAL; TO ADD , WHY DO I HAVE TO TELL; YOU THIS YOU'VE USED IT IN SO; MANY GAMES YOU DICK HEAD;SCORE;LDY #5       ;* LSB DIGIT;; SECOND ENTRY POINT;ADDLOP;STA SCRADD;LDA SCOREP,YCMP #32BNE NTORT;LDA #$30;NTORT;CLCADC SCRADDCMP #$3ABMI SCOREL;SECSBC #$ASTA SCOREP,Y;LDA #1DEYBPL ADDLOP;SCOREL;STA SCOREP,Y;LDA SCOREP+2    ;* THOUSANDSAND #15         ;* 0 - 15CMP XTRA;BEQ XARGON;STA XTRA;LDA LIVESCMP #9;BEQ XARGON;INC LIVESINC $400+200+35;XARGON;RTS;;.END