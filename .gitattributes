# Preserve historical input bytes, including the 1992 CRLF text exports
# and the CR-terminated 2026 SEQ extractions.
*.py text eol=lf
*.sh text eol=lf
*.md text eol=lf
*.json text eol=lf
*.ini text eol=lf
*.cfg text eol=lf
*.yml text eol=lf
*.mjs text eol=lf
*.js text eol=lf
*.css text eol=lf
*.html text eol=lf
Makefile text eol=lf
*.png binary
*.gif binary
*.jpg binary
*.pdf binary
*.prg binary
*.BIN binary
*.PRG binary
*.ZIP binary
*.d64 binary
*.seq binary
*.tap binary
*.vsf binary

# These override generic rules for every preserved input and reference.
"/Original Source Recovered/**" -text -whitespace -diff
"/Original Artifacts/**" -text -whitespace
"/Other Versions/**" -text -whitespace -diff

# Keep pinned library text and the generated handbook intact.
/scripts/vendor/** -whitespace
/docs/*.html -whitespace
