; >S:DUMPER; PUT "DUMPER";; COPIES THE 'SCRBUF' TO THE; SCREEN - GLOPPILY.;FADEIN;LDA MULTI1PHALDA MULTI2PHA;JSR CLSWIN;; CLEAR WINDOW;LDA SNDFLGBEQ NSND1;LDA #%00101111 ;* CHAN#2STA VOL;NSND1;LDA #3STA COUNT;; 4 CHARS TO COPY ACROSS;COP1;JSR RANDOM;LDA RND+1AND #3STA SOU2HI;; RANDOM HI-BIT START;LDA RND+2AND #$80STA SOU2LO;; LO-BIT START AT 0 OR 128;LDA SOU2LOCLCADC #16STA SOU2LO;LDA SOU2HIADC #0STA SOU2HI;LDA #<$400STA OLLDA #>$400STA OL+1;LDA #<SCRBUFSTA DLLDA #>SCRBUFSTA DL+1;LDX COUNTLDA COMPAR,X ;* COPY TABLESTA COPY;LDA COLTBL,X ;* COLOUR OF BLOCKSSTA COLOUR;LDX #23;COP2;LDY #31;COP3;LDA (DL),Y ;* GET BUFFER COPY;CMP COPY   ;* THE ONE TO COPY ?BNE WRONG  ;* NOT THIS ONE.;STA (OL),Y ;* ONTO SCREEN;LDA OLSTA CL;LDA OL+1CLCADC #$D4STA CL+1;LDA COLOURSTA (CL),Y ;* PUT A COLOUR ON;WRONG;DEYBPL COP3  ;* FINISH LINE;LDA OLCLCADC #40STA OL;LDA OL+1ADC #0STA OL+1;LDA DLCLCADC #40STA DL;LDA DL+1ADC #0STA DL+1;DEXBPL COP2  ;* ALL THE LINES;LDX DELLY ;* SET UP BEFORE CALLEDJSR DELAY+2;DEC COUNT ;* 4 CHARS TO COPYBMI COPO1;JMP COP1;COPO1;LDA #0STA VOL   ;* SOUND OFF;PLASTA MULTI2;PLASTA MULTI1;RTS;COMPAR;.BYTE 199,198,200,197;COLTBL .BYTE $0F,$0A,$0D,$0C;.END