; >S:TITLE-WORKS; PUT "TITLE-WORKS";; DO THE BITS ON THE TITLE PAGE;BDRGLP;; SCROLL THE BORDER ROUND;LDA $D81FSTA STOPA  ;* SAVE IT;LDA $DBB7STA STOPB;LDA $DB98STA STOPC;; 3 BITS SAVED;LDX #30;QAT1;LDA $D800,XSTA $D801,X;DEXBPL QAT1;LDA #22STA BORDY;QAT2;LDX #31LDY BORDYJSR XY;LDY #0LDA (CL),Y;LDY #40STA (CL),Y;DEC BORDYBNE QAT2;LDA STOPASTA $D847;LDX #0;QAT3;LDA $DB99,XSTA $DB98,X;INXCPX #30BNE QAT3;LDA STOPBSTA $DBB6;LDA #0STA BORDY;QAT4;LDX #0LDY BORDYJSR XY;LDY #40LDA (CL),Y;LDY #0STA (CL),Y;INC BORDYLDA BORDYCMP #23BNE QAT4;LDA STOPCSTA $DB70;RTS;;;;;;;;.END