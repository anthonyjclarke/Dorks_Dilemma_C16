; >S:BORDER; PUT "BORDER";PRBDER;; PRINT THE BORDER CHARS ON; THE WINDOW ON THE RIGHT.;;;LDX #6;PRB1;LDA #203STA $C20-$800,X     ;* GLOP CHARSTA $FB8-$800,X     ;* GLOP CHARSTA $DB0-$800,X     ;* GLOP CHARSTA $EC8-$800,X     ;* GLOP CHAR;LDA #$71STA $D820,XSTA $DBB8,X;DEXBNE PRB1;; NOW THE SIDES;LDA #22STA TY;PRB2;LDX #32LDY TY;JSR XY;LDY #0LDA #204STA (SL),Y;LDA #$71STA (CL),Y;LDY #7LDA #204STA (SL),Y;LDA #$71STA (CL),Y;DEC TYBNE PRB2;LDX #205STX $C20-$800;INXSTX $C27-$800;INXSTX $F98+32-$800;INXSTX $F98+31+8-$800;; CORNER CHARS ON;LDX #249STX $DB0-$800STX $EC8-$800;INXSTX $DB7-$800STX $ECF-$800;; MID BITS;RTS;;.END