{
    "version": "2.0.0",
    "tasks": [
        {
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "label": "PlatformIO: Build",
            "type": "process",
            "command": "pio",
            "args": [
                "run",
                "-e",
                "c16"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "label": "PlatformIO: Clean",
            "type": "process",
            "command": "pio",
            "args": [
                "run",
                "-e",
                "c16",
                "--target",
                "clean"
            ]
        },
        {
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "label": "PlatformIO: Run in VICE",
            "type": "process",
            "command": "pio",
            "args": [
                "run",
                "-e",
                "c16",
                "--target",
                "upload"
            ]
        },
        {
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "label": "Build: Recovered C16",
            "type": "process",
            "command": "python3",
            "args": [
                "scripts/restore_c16.py"
            ]
        },
        {
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "label": "Run: VICE Emulator",
            "type": "process",
            "command": "python3",
            "args": [
                "scripts/run_vice.py",
                "build/dorks.prg"
            ],
            "dependsOn": "Build: Recovered C16"
        },
        {
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "label": "Run: Original Binary",
            "type": "process",
            "command": "python3",
            "args": [
                "scripts/run_vice.py",
                "Original_Files/DORKSDIL.BIN"
            ]
        },
        {
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "label": "Test: Restoration",
            "type": "process",
            "command": "python3",
            "args": [
                "-m",
                "unittest",
                "discover",
                "-s",
                "test",
                "-p",
                "test_*.py",
                "-v"
            ]
        },
        {
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [],
            "label": "Test: VICE Gameplay",
            "type": "process",
            "command": "python3",
            "args": [
                "scripts/verify_vice.py"
            ],
            "dependsOn": "Build: Recovered C16"
        }
    ]
}
