{
    // Editor settings for assembly files
    "[asm]": {
        "editor.tabSize": 8,
        "editor.insertSpaces": false,
        "editor.detectIndentation": false,
        "editor.rulers": [80],
        "editor.wordWrap": "off"
    },

    // File associations
    "files.associations": {
        "*.s": "asm",
        "*.asm": "asm",
        "*.inc": "asm",
        "*.cfg": "ini",
        "platformio.ini": "ini"
    },

    // Exclude build artifacts from search
    "search.exclude": {
        "**/build": true,
        "**/.pio": true,
        "**/*.prg": true,
        "**/*.o": true,
        "**/*.lst": true
    },

    // File explorer settings
    "files.exclude": {
        "**/.DS_Store": true,
        "**/__pycache__": true,
        "**/*.pyc": true
    },

    // PlatformIO settings
    "platformio-ide.useBuiltinPIOCore": true,
    "platformio-ide.activateOnlyOnPlatformIOProject": false,
    "platformio-ide.autoRebuildAutocompleteIndex": true,

    // Terminal settings
    "terminal.integrated.env.osx": {
        "PATH": "/usr/local/bin:/opt/homebrew/bin:${env:PATH}"
    },

    // Code formatting
    "editor.formatOnSave": false,
    "editor.trimAutoWhitespace": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,

    // Git settings
    "git.ignoreLimitWarning": true,

    // Breadcrumbs
    "breadcrumbs.enabled": true,

    // Minimap
    "editor.minimap.enabled": true,
    "editor.minimap.maxColumn": 80,

    // Custom color for assembly comments
    "editor.tokenColorCustomizations": {
        "comments": "#6A9955"
    }
}
