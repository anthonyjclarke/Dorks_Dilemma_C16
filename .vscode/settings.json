{
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "files.associations": {
        "*.s": "ca65",
        "*.SEQ": "ca65",
        "*.seq": "ca65",
        "*.cfg": "ini",
        "*.asm": "ca65",
        "*.inc": "ca65"
    },
    "files.exclude": {
        "**/.DS_Store": true,
        "**/__pycache__": true
    },
    "search.exclude": {
        "build/**": true,
        ".pio/**": true
    },
    "files.trimTrailingWhitespace": false,
    "files.insertFinalNewline": false,
    "platformio-ide.useBuiltinPIOCore": true,
    "terminal.integrated.env.osx": {
        "PATH": "/opt/homebrew/bin:/usr/local/bin:${env:PATH}"
    }
}
